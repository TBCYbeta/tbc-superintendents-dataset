library(here)
library(purrr)
library(readr)
library(writexl)
####################################
# Process 1990-2010 data
####################################
tx_dir_path <- here("data", "raw", "tx")
files_9010 <- list.files(
path = tx_dir_path,
pattern = "^Supers (199\\d|20\\d{2})-\\d{4}\\.csv$",
full.names = TRUE
)
stopifnot(length(files_9010) > 0)
tx_90_10 <- map_dfr(files_9010, read_csv, show_col_types = FALSE, .id = "file_id") |>
dplyr::mutate(source_file = basename(files_9010[as.integer(file_id)])) |>
dplyr::select(-file_id)
district =
names(tx_90_10) <- tolower(names(tx_90_10))
tx_90_10_clean <- tx_90_10 %>%
transmute(
year              = as.integer(str_sub(year, 1, 4)),
leaid             = as.integer(str_sub(district, -4, -1)),
leaid_name        = str_to_title(distname),
salary            = calc_full_fte_pay,
name_raw          = paste(str_to_title(lname),str_to_title(fname))
)
tx_90_10_clean <- tx_90_10_clean %>%
mutate(
salary            = na_if(salary, 0),
name_raw          = if_else(name_raw == "Not Reported", NA_character_, name_raw),
leaid             = as.numeric(paste0("48", sprintf("%05d", leaid)))
)
# LEAIDs must be 7 digits and start with 48
stopifnot(
all(nchar(as.character(tx_90_10_clean$leaid)) == 7),
all(substr(as.character(tx_90_10_clean$leaid), 1, 2) == "48")
)
#write_xlsx(tx_90_10_clean, path = file.path(tx_dir_path, "tx_90_10_clean.xlsx"))
####################################
# Process 2011-2017 data
####################################
tx_dir_path <- here("data", "raw", "tx")
years <- 2011:2017
tx_11_17 <- purrr::map_dfr(years, function(y) {
dir_y <- here("data", "raw", "tx", paste0("Nonteachers ", y, "-", y + 1))
files_y <- list.files(dir_y, pattern = "\\.csv$", full.names = TRUE)
stopifnot(length(files_y) > 0)
purrr::map_dfr(
files_y,
~ readr::read_csv(
.x,
col_types = readr::cols(.default = readr::col_character()),
show_col_types = FALSE
)
) %>%
rename_with(tolower) %>%
mutate(year = as.integer(y))
})
tx_11_17_clean <- tx_11_17 %>%
filter(
!is.na(rolex),
str_detect(rolex, regex("SUPERINTENDENT", ignore_case = TRUE))
) %>%
transmute(
year              = as.integer(year),
leaid             = as.integer(str_sub(district, -4, -1)),
leaid_name        = str_to_title(distname),
salary            = as.integer(totalpay),
name_raw          = paste(str_to_title(lname),str_to_title(fname))
)
tx_11_17_clean <- tx_11_17_clean %>%
mutate(
salary            = na_if(salary, 0),
name_raw          = if_else(name_raw == "Not Reported", NA_character_, name_raw),
leaid             = as.numeric(paste0("48", sprintf("%05d", leaid)))
)
# LEAIDs must be 7 digits and start with 48
stopifnot(
all(nchar(as.character(tx_11_17_clean$leaid)) == 7),
all(substr(as.character(tx_11_17_clean$leaid), 1, 2) == "48")
)
#write_xlsx(tx_11_17_clean, path = file.path(tx_dir_path, "tx_11_17_clean.xlsx"))
####################################
# Process 2018-2022 data
####################################
library(tidyverse)
library(here)
library(writexl)
tx_dir_path <- here("data", "raw", "tx")
years2 <- 2018:2022
tx_18_22 <- purrr::map_dfr(years2, function(y) {
# file name like "2018-19 NonTeachers.csv"
f_y <- file.path(tx_dir_path, paste0(y, "-", substr(y + 1, 3, 4), " NonTeachers.csv"))
stopifnot(file.exists(f_y))
readr::read_csv(
f_y,
col_types = readr::cols(.default = readr::col_character()),
show_col_types = FALSE
) %>%
rename_with(tolower) %>%
mutate(year = as.integer(y))
})
tx_18_22_clean <- tx_18_22 %>%
filter(
!is.na(rolex),
str_detect(rolex, regex("SUPERINTENDENT", ignore_case = TRUE))
) %>%
transmute(
year       = as.integer(year),
# keep raw pieces for the district-id fix
county     = as.character(county),
district   = as.character(district),
distname   = distname,
fname      = fname,
lname      = lname,
totalpay   = totalpay
) %>%
mutate(
# title-case names and build name_raw
fname    = str_to_title(fname),
lname    = str_to_title(lname),
name_raw = paste(lname, fname),
# salary
salary   = suppressWarnings(as.integer(totalpay)),
salary   = na_if(salary, 0L),
# handle "Not Reported"
name_raw = if_else(name_raw == "Not Reported", NA_character_, name_raw),
# FIX: remove county prefix from district to recover TEA district number
district = str_remove(district, paste0("^", county)),
district = suppressWarnings(as.integer(district)),
# construct NCES LEAID (Texas = 48 + 5-digit district)
leaid = as.numeric(paste0("48", sprintf("%05d", district))),
# standardize district name
leaid_name = str_to_title(distname)
) %>%
select(
year,
leaid,
leaid_name,
salary,
name_raw
)
# Dropped one anomalous charter LEA with nonstandard LEAID length. (2018: 48227827)
tx_18_22_clean %>%
filter(nchar(as.character(leaid)) != 7)
tx_18_22_clean <- tx_18_22_clean %>%
filter(nchar(as.character(leaid)) == 7)
# LEAIDs must be 7 digits and start with 48
stopifnot(
all(nchar(as.character(tx_18_22_clean$leaid)) == 7),
all(substr(as.character(tx_18_22_clean$leaid), 1, 2) == "48")
)
tx_18_22 %>%
rename_with(tolower) %>%
mutate(is_charter = str_detect(dist_charttype, regex("CHARTER", TRUE))) %>%
count(year, is_charter)
#write_xlsx(tx_18_22_clean, path = file.path(tx_dir_path, "tx_18_22_clean.xlsx"))
####################################
# Process 2023-2024 data
####################################
library(tidyverse)
library(readxl)
library(here)
library(stringr)
library(writexl)
library(janitor)
tx_dir_path <- here("data", "raw", "tx")
read_tsd_index_min <- function(file_year) {
f <- file.path(tx_dir_path, paste0("TSD-", file_year, "-final.xlsx"))
stopifnot(file.exists(f))
sheet_name <- "Index of Districts and Charters"
# 1) read without headers
raw0 <- readxl::read_xlsx(f, sheet = sheet_name, col_names = FALSE)
# 2) find the header row (look for "school district" in col 1)
header_row <- which(str_detect(tolower(as.character(raw0[[1]])), "^school\\s*district$"))[1]
if (is.na(header_row)) {
stop("Could not find header row containing 'School district' in col 1 for ", basename(f))
}
# 3) read again using that header
df <- readxl::read_xlsx(f, sheet = sheet_name, skip = header_row - 1) %>%
janitor::clean_names()  # makes names like: school_district, cnty_dist_number, district_superintendent
# 4) very permissive column matching
col_school <- names(df)[str_detect(names(df), "^school_district$|school_district")][1]
col_cdn    <- names(df)[str_detect(names(df), "cnty.*dist.*number|county.*dist.*number|cnty_dist")][1]
col_super  <- names(df)[str_detect(names(df), "district_superintendent|superintendent")][1]
if (any(is.na(c(col_school, col_cdn, col_super)))) {
message("Columns found in ", basename(f), " / ", sheet_name, ":")
print(names(df))
stop("Missing expected columns in ", basename(f))
}
df %>%
transmute(
year       = as.integer(file_year - 1),
leaid_name = str_squish(as.character(.data[[col_school]])),
cdn_raw    = str_squish(as.character(.data[[col_cdn]])),
name_raw   = str_squish(as.character(.data[[col_super]])),
salary     = NA_integer_
) %>%
mutate(
cdn_digits = str_remove_all(cdn_raw, "[^0-9]"),
district_code = if_else(
nchar(cdn_digits) >= 6,
as.integer(str_sub(cdn_digits, -3, -1)),  # last 3 digits of cccddd
NA_integer_
),
leaid = if_else(
!is.na(district_code),
as.numeric(paste0("48", sprintf("%05d", district_code))),
NA_real_
),
leaid_name = str_to_title(leaid_name),
name_raw = na_if(name_raw, ""),
name_raw = if_else(
!is.na(name_raw) & str_to_upper(name_raw) == "NOT REPORTED",
NA_character_,
name_raw
),
name_raw = if_else(is.na(name_raw), NA_character_, str_to_title(name_raw))
) %>%
filter(!is.na(leaid)) %>%
select(year, leaid, leaid_name, salary, name_raw)
}
# Build academic years: 2023 from TSD-2024; 2024 from TSD-2025
tx_23_24_clean <- bind_rows(
read_tsd_index_min(2024),
read_tsd_index_min(2025)
)
#write_xlsx(tx_23_24_clean, file.path(tx_dir_path, "tx_23_24_clean.xlsx"))
saveRDS(tx_23_24_clean, file.path(tx_dir_path, "tx_23_24_clean.rds"))
####################################
# Combine all years
####################################
tx_raw <- bind_rows(
tx_90_10_clean,
tx_11_17_clean,
tx_18_22_clean,
tx_23_24_clean
)
write_xlsx(tx_raw, file.path(tx_dir_path, "tx_raw.xlsx"))
# Optional: quick sanity checks
stopifnot(all(c("year","leaid","leaid_name","salary","name_raw") %in% names(tx_raw)))
summary(nchar(as.character(tx_raw$leaid)))
####################################
# Merge Urban Institute data
####################################
dist_chars_path <- here("data", "raw", "urban_inst")
tx_distids <- data.frame()
years <- 1990:2024
# Loop through years to load and process data
for(y in years){
print(y)
# Load Rda file
load(file.path(dist_chars_path, paste0("chars_", y, ".Rda")))
df <- get(paste0("chars_", y))
# Process the data
temp <- df %>%
filter(fips == "Texas") %>%
select(year, leaid, state_leaid, nces_lea_name = lea_name, agency_charter_indicator, enrollment) %>%
mutate(leaid = if(is.character(leaid)) {
parse_number(leaid)
} else {
as.numeric(leaid)  # If already numeric, just ensure it's numeric
},
state_leaid_n = as.numeric(str_remove_all(state_leaid, "TX-")))
tx_distids <- bind_rows(tx_distids, temp)
# Remove the loaded object
rm(list = paste0("chars_", y))
}
# Merge with `tx_raw`
tx_lea <- left_join(tx_raw, tx_distids, by = c("leaid","year"))
tx_lea <- tx_lea %>% rename(charter = agency_charter_indicator)
# Add state and ID fields
tx_lea <- tx_lea %>% distinct(leaid, year, full_name, .keep_all = TRUE)
tx_lea
write.csv(tx_lea, "tx_lea.csv")
# Add state and ID fields
tx_lea <- tx_lea %>% distinct(leaid, year, name_raw, .keep_all = TRUE)
tx_lea <- tx_lea %>% arrange(leaid, year)
tx_lea <- tx_lea %>%
mutate(state = "TX",
id = paste0("tx", str_pad(1:nrow(tx_lea), width = 5, side = "left", pad = "0")),
name_raw = full_name,
name_clean = clean_names(name_raw))
tx_lea <- tx_lea %>%
mutate(state = "TX",
id = paste0("tx", str_pad(1:nrow(tx_lea), width = 5, side = "left", pad = "0")),
name_clean = clean_names(name_raw))
# Create table with relevant columns
all_supers <- tx_lea %>% select(id, state, leaid, leaid_name = dist_name, name_raw, name_clean, year, charter)
all_supers <- tx_lea %>% select(id, state, leaid, leaid_name, name_raw, name_clean, year, charter)
all_supers$leaid_name <- str_to_title(all_supers$leaid_name)
# Save the processed data
save(all_supers, file = file.path(clean_path, "all_supers_tx.Rda"))
# data checks
data_checks(all_supers)
duplicates <- all_supers %>%
group_by(year, leaid) %>%
filter(n() > 1) %>%
arrange(year, leaid)
#write.csv(all_supers, "all_supers_ga.csv")
write.csv(duplicates, "duplicates.csv")
closeAllConnections()
rm(list = ls())
source(here::here("scripts/00_setup.R"))
